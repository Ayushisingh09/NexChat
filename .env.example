PORT=3000
NODE_ENV=development

# Database
# Use postgresql://postgres:password123@localhost:5432/nexchat?schema=public for local development with docker db
DATABASE_URL="postgresql://postgres:password123@localhost:5432/nexchat?schema=public"

# Cache & Presence
REDIS_URL="redis://localhost:6379"

# Authentication Configs
JWT_ACCESS_SECRET="super_secret_access_key_replace_in_production_12345!"
JWT_REFRESH_SECRET="super_secret_refresh_key_replace_in_production_54321!"
REQUIRE_OTP_VERIFICATION=true

# Base URL of the frontend, used to build password reset links
CLIENT_URL="http://localhost:5173"

# Cloudflare R2 / S3
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY="your_r2_access_key"
R2_SECRET_KEY="your_r2_secret_key"
R2_BUCKET="your_r2_bucket_name"
R2_PUBLIC_URL="https://pub-someid.r2.dev"

# Email Verification (Nodemailer SMTP primary, Resend fallback)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM_NAME="NexChat"
RESEND_API_KEY="re_placeholder"

# SMS Verification (Twilio)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Push Notifications (Firebase Cloud Messaging)
# Base64-encode your service account JSON: base64 -w0 serviceAccount.json
FCM_SERVICE_ACCOUNT_BASE64=

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Cipher AI Assistant + AI image generation (FLUX.1-schnell).
# The same NVIDIA key powers Cipher chat (integrate.api.nvidia.com) and
# AI avatar/story image generation (ai.api.nvidia.com). Get a free key at
# https://build.nvidia.com (nvapi- prefixed, no credit card required).
NVIDIA_NIM_API_KEY=nvapi-your-key
GROQ_API_KEY=your-groq-key
CIPHER_DAILY_TOKEN_LIMIT=50000
CIPHER_MAX_HISTORY=20
# Or, alternatively, the raw stringified JSON (FCM_SERVICE_ACCOUNT_BASE64 takes priority):
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
